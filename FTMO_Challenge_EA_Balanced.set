//+------------------------------------------------------------------+
//|                                     FTMO_Challenge_EA_Preset.set |
//|                                      Optimale settings voor FTMO |
//+------------------------------------------------------------------+

; Dit is een preset bestand voor de FTMO Challenge EA
; Om te gebruiken:
; 1. Kopieer dit bestand naar MQL4/Presets
; 2. In EA settings, klik op "Load" en selecteer dit bestand

; === Risk Management Settings ===
RiskPercentPerTrade=1.0
MaxDailyLossPercent=4.0
MaxTotalLossPercent=8.0
MaxOpenPositions=3

; === Trading Strategy Settings ===
FastMA_Period=20
SlowMA_Period=50
RSI_Period=14
RSI_Overbought=70
RSI_Oversold=30
ATR_Period=14

; === Trade Management ===
StopLossATR=2.0
TakeProfitATR=3.0
UseTrailingStop=1
TrailingStopATR=1.5
MinRiskRewardRatio=1.5

; === Trading Filters ===
StartHour=2
EndHour=22
MaxSpreadPips=3.0
TradeOnMonday=1
TradeOnFriday=1

; === Expert Advisor Settings ===
MagicNumber=123456
TradeComment=FTMO_EA
